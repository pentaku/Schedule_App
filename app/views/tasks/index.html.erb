<h3>タスク情報一覧</h3>

<table>
  <thead>
    <tr>
      <th>id</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
      <th>参照</th>
      <th>編集</th>
      <th>削除</th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.id %></td>
        <td><%= task.title %></td>
        <td><%= task.start_date.to_s(:ymd) %></td>
        <td><%= task.end_date.to_s(:ymd) %></td>
        <td>
          <%= task.is_all_day ? "⭕️" : "" %>
        </td>
        <td><%= task.updated_at.to_s(:ymd_hm) %></td>
        <td>
          <%= link_to "参照", task %>
        </td>
        <td>
          <%= link_to "編集", edit_task_path(task) %>
        </td>
        <td>
          <%= link_to "削除", task_path(task), method: :delete, data: { confirm: "本当に削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "予定の新規登録", :new_task %></p>

<p>
  本日の日付：<%= Date.today.strftime("%Y年%m月%d日") %><br>
  予定合計：<%= @tasks.count %> 件
</p>
